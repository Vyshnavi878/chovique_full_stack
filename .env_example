# Chovique Backend Production Environment Variables Example
# DO NOT PUT REAL SECRETS IN THIS FILE

APP_NAME=CHOVIQUE
APP_VERSION=1.0.0
DEBUG=False
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chovique_db
DB_ECHO=False
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=your_production_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=["https://chovique.vercel.app","http://localhost:5173"]

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@chovique.com
MAIL_PASSWORD=your_smtp_password_here
MAIL_FROM=notifications@chovique.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

OTP_EXPIRE_SECONDS=300
MAX_OTP_ATTEMPTS=5
MAX_OTP_RESEND_ATTEMPTS=3
OTP_RESEND_LOCKOUT_SECONDS=600

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

RESEND_API_KEY=your_resend_api_key_here

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

SUPERADMIN_EMAIL=superadmin@chovique.com
SUPERADMIN_PASSWORD=your_superadmin_password_here
